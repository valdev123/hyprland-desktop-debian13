# Mako lit ce fichier, et il ne règle rien lui-même.
#
# Sur une option en double, la dernière lue gagne : local vient donc après
# defaults. Les blocs de critères s'appliquent aussi dans l'ordre de lecture,
# c'est la seule façon qu'un [urgency=critical] personnel batte le nôtre.
#
# Ce découpage n'est pas cosmétique : « include » est refusé à l'intérieur d'un
# bloc de critères, et la portée globale ne se rouvre pas. Comme defaults se
# termine sur [urgency=critical], un include posé à sa suite serait rejeté.
#
# Les deux fichiers doivent exister : un include introuvable et mako refuse de
# démarrer — plus aucune notification, sans un mot. local est créé par
# scripts/04-dotfiles.sh.
include=~/.config/mako/defaults
include=~/.config/mako/local
