{
  "layer": "top",
  "position": "bottom",
  "height": 38,
  "spacing": 0,

  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["pulseaudio", "network", "cpu", "memory", "tray"],

  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate"
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 60,
    "separate-outputs": true
  },

  // Le « L » applique la locale ci-dessous ; sans lui le jour et le mois
  // sortent en anglais, la session lancée par greetd n'ayant pas de LANG.
  "clock": {
    "format": "{:L%H:%M  %a %d %b}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "locale": "fr_FR.UTF-8"
  },

  // Les seuils nourrissent les classes .warning et .critical de style.css :
  // le jaune et le rouge n'apparaissent que quand quelque chose se passe.
  "cpu": {
    "format": "󰻠 {usage}%",
    "interval": 3,
    "states": { "warning": 75, "critical": 90 }
  },

  "memory": {
    "format": "󰍛 {percentage}%",
    "interval": 5,
    "states": { "warning": 80, "critical": 92 }
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
    "on-click": "pavucontrol",
    "scroll-step": 5
  },

  "network": {
    "format-wifi": "󰖩 {signalStrength}%",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip-format-wifi": "{essid} — {ipaddr}",
    "tooltip-format": "{ifname} — {ipaddr}",
    "on-click": "nm-connection-editor"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 10
  }
}
